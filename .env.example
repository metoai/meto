NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
DEEPSEEK_API_KEY=your_deepseek_api_key
# Latest DeepSeek chat model (fallback: deepseek-chat)
DEEPSEEK_MODEL=deepseek-v4-flash
# Optional fallback when DeepSeek is unavailable or out of balance
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
# Use www in production — Vercel redirects apex metoai.site → www.metoai.site
NEXT_PUBLIC_SITE_URL=https://www.metoai.site

# Billing (Polar) — https://polar.sh/docs/guides/nextjs
# Sandbox and production are fully separate: tokens and product IDs from one do NOT work in the other.
# Create tokens at sandbox.polar.sh (sandbox) or polar.sh (production).
POLAR_ACCESS_TOKEN=polar_oat_...
POLAR_WEBHOOK_SECRET=...
POLAR_PRO_PRODUCT_ID=...
# Must match where the token was created: sandbox | production
POLAR_SERVER=sandbox

# Supabase service role (webhooks + billing sync + admin API)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Admin portal — comma-separated emails with full admin access
# Also seed admin_users via scripts/create-admin-user.mjs
METO_ADMIN_EMAILS=admin@metoai.site

# Optional: treat all users as Pro (early-access grandfathering)
# METO_GRANDFATHER_PRO=true

# Optional: cron to expire trials (Authorization: Bearer <secret>)
# CRON_SECRET=your_random_secret

# Optional: distributed rate limits (recommended for production)
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_token

# Product analytics (PostHog) — https://posthog.com
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Supabase Auth: enable leaked password protection in dashboard (Security → Auth)

# V2 knowledge layer (Phase 2+) — all off by default; no behavior change until enabled
# KNOWLEDGE_LAYER_ENABLED=false
# KNOWLEDGE_WRITE_ENABLED=false
# KNOWLEDGE_READ_ENABLED=false
# WORKSPACE_MODE_DEV_ENABLED=false
# CONTEXT_SCORE_V2_ENABLED=false
#
# Recommended rollout:
# 1) LAYER + WRITE — backfill + dual-write on updates/onboarding
# 2) READ — MCP + sections served from generated_views
# 3) WORKSPACE_MODE_DEV — Projects UI + /api/projects
# 4) CONTEXT_SCORE_V2 — knowledge graph issues blended into score
